# Copy to .env for local development. Never commit .env.
# Every value here belongs to Navy Compare's own accounts, created fresh:
# nothing is shared with any other client's project.

# Supabase (staging project) — Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (port 5432) for migrations and jobs.
# Local Docker Compose: postgresql://postgres:postgres@localhost:5432/navy_compare
DATABASE_URL=

# Signs Flask's session (CSRF token only). Any long random string.
FLASK_SECRET_KEY=

# Local http: cookies must not be Secure or the browser drops them.
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8080

# The account(s) no other admin can suspend, demote or take over.
OWNER_EMAILS=chris.eade@bugbean.com.au

# Anthropic. CLAUDE_BACKEND=vertex with GCP_PROJECT_ID keeps AI calls in
# australia-southeast1 instead.
ANTHROPIC_API_KEY=
# CLAUDE_BACKEND=vertex
# GCP_PROJECT_ID=
# WRITER_MODEL=claude-sonnet-5-5

# Resend, on a domain verified for Navy Compare
RESEND_API_KEY=
MAIL_FROM=Navy Compare <noreply@your-verified-domain>
FEEDBACK_EMAIL=
